#!/bin/bash

set -e

REPO_PATH=$(realpath "${1:-.}")

if [[ ! -d "$REPO_PATH" ]]; then
    echo "Error: Directory not found at '$REPO_PATH'" >&2
    exit 1
fi

SESSION_NAME=$(basename "$REPO_PATH")

if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Session '$SESSION_NAME' already exists. Attaching..."
    exec tmux attach-session -t "$SESSION_NAME"
fi

activate_venv() {
    if [[ -f "$REPO_PATH/.venv/bin/activate" ]]; then
        echo "source .venv/bin/activate"
    elif [[ -f "$REPO_PATH/pyproject.toml" || -f "$REPO_PATH/uv.lock" ]]; then
        echo "uv venv && source .venv/bin/activate"
    fi
}

VENV_CMD=$(activate_venv)

send_setup() {
    local target="$1"
    if [[ -n "$VENV_CMD" ]]; then
        tmux send-keys -t "$target" "$VENV_CMD" C-m
    fi
}

# Create session with first window (sage)
tmux new-session -d -s "$SESSION_NAME" -c "$REPO_PATH" -n "sage"
send_setup "$SESSION_NAME:sage"
tmux send-keys -t "$SESSION_NAME:sage" "sage chat" C-m

# Terminal window
tmux new-window -a -c "$REPO_PATH" -t "$SESSION_NAME" -n "terminal"
send_setup "$SESSION_NAME:terminal"

# Nvim window
tmux new-window -a -c "$REPO_PATH" -t "$SESSION_NAME" -n "nvim"
send_setup "$SESSION_NAME:nvim"
tmux send-keys -t "$SESSION_NAME:nvim" "sleep 1 && nvim ." C-m

# Focus on terminal window
tmux select-window -t "$SESSION_NAME:terminal"

exec tmux attach-session -t "$SESSION_NAME"
