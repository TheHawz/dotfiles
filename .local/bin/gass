#!/bin/bash

GOWSUME=/Applications/gowsumed.app/Contents/MacOS/gowsume

case "$1" in
    strategist)  role="pro:sp-analytics-strategist-rw" ;;
    data)        role="analytics:sp-analytics-data-rw" ;;
    datalab)     role="analytics:sp-analytics-datalab-rw" ;;
    data-delete) role="analytics:sp-analytics-data-delete" ;;
    admin-ro)    role="analytics:sp-admin-ro" ;;
    analytics)   role="analytics:sp-analytics-strategist-rw" ;;
    *)
        echo "Usage: gass <role>"
        echo "Available roles: strategist, data, datalab, data-delete, admin-ro, analytics"
        exit 1
        ;;
esac

output=$($GOWSUME use "$role")
if [[ $? -ne 0 ]]; then
    echo "Error assuming role '$role'" >&2
    exit 1
fi

export $output
echo "Role $role correctly assumed."

