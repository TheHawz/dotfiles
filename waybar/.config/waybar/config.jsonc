{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  "modules-left": ["custom/menu", "hyprland/workspaces"],
  "modules-center": ["clock", "hyprland/language"],
  "modules-right": ["tray", "bluetooth", "network", "wireplumber", "cpu", "memory", "temperature"],

  "custom/menu": {
    "format": "☰",
    "tooltip": false,
    "on-click": "fuzzel"
  },

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  // Equivalente a "dddd HH:mm - yyyy-MM-dd - 'Week' ww" de tu shell.json
  "clock": {
    "format": "{:%A %H:%M - %Y-%m-%d - Week %V}",
    "format-alt": "{:%-d %B W%V %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "format": { "today": "<b>{}</b>" }
    }
  },

  "hyprland/language": {
    "format": "{short}",
    "tooltip": false
  },

  "tray": { "spacing": 10 },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{device_alias}",
    "on-click": "blueberry || blueman-manager"
  },

  "network": {
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "foot -e nmtui"
  },

  "wireplumber": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "on-click": "swayosd-client --output-volume mute-toggle",
    "on-scroll-up": "swayosd-client --output-volume raise",
    "on-scroll-down": "swayosd-client --output-volume lower"
  },

  "cpu": { "format": "󰻠 {usage}%", "interval": 5 },
  "memory": { "format": "󰍛 {percentage}%", "interval": 5 },
  "temperature": {
    "hwmon-path-abs": "/sys/class/hwmon",
    "critical-threshold": 80,
    "format": "󰔏 {temperatureC}°C",
    "interval": 5
  }
}
