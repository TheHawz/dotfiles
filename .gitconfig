[push]
	autoSetupRemote = true
[alias]
	a = add
	aa = add --all
	ap = add --patch
	b = branch
	ba = branch --all
	br = branch --remote
	c = commit
	ca = commit --amend
	cm = commit -m
	cam = commit -am
	co = checkout
	df = diff
	dc = diff --cached
	l = log --date=format:'%b %d, %Y' --pretty=format:'%C(yellow bold)%h%Creset%C(white)%d%Creset %s%n %C(blue)%aN (%cd)%n'
	lg = log --graph --stat --pretty=format:'%C(yellow bold)%h%Creset%C(white)%d%Creset %s%n %C(blue)%aN (%cd)%n'
	f = fetch
	pl = pull
	ps = push
	psf = push --force-with-lease
	s = status
	wa = worktree add
	wl = worktree list
[core]
	excludesfiles = /Users/pablo.losada/.gitignore_global
[user]
	name = Pablo Losada
	email = pablo.losada@socialpoint.es
	signingkey = 4254188EC2F52F3C
[commit]
	gpgsign = true
; include for all repositories inside $HOME/to/group
[includeIf "gitdir:~/personal-repos/"]
	path = ~/.personal.gituser
[includeIf "gitdir:~/dotfiles/"]
	path = ~/.personal.gituser
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
