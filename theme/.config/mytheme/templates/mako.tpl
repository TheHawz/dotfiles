font=JetBrainsMono Nerd Font 10
background-color={{ background }}f2
text-color={{ foreground }}
border-color={{ accent }}
progress-color=over {{ selection }}
border-size=2
border-radius=8
padding=12
margin=8
default-timeout=5000
anchor=top-right

[urgency=low]
border-color={{ muted }}

[urgency=critical]
border-color={{ red }}
default-timeout=0
