{
  "theme": "Catppuccin Macchiato",
  "buffer_font_family": "MesloLGMDZ Nerd Font Mono",
  "ui_font_family": "MesloLGMDZ Nerd Font Mono",
  "buffer_font_size": 14,
  "ui_font_size": 14,
  "vim_mode": true,
  "auto_update": true,
  "format_on_save": "on",
  "tab_size": 2,
  "hard_tabs": false,
  "show_whitespaces": "selection",
  "relative_line_numbers": "enabled",
  "cursor_blink": false,
  "scrollbar": {
    "show": "auto",
  },
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "right",
  },
  "outline_panel": {
    "dock": "right",
  },
  "terminal": {
    "dock": "bottom",
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "gofumpt": true,
        "staticcheck": true,
      },
    },
  },

  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright"],
      "format_on_save": "off",
      "formatter": [
        {
          "code_action": "source.organizeImports.ruff",
        },
        {
          "code_action": "source.fixAll.ruff",
        },
        {
          "language_server": {
            "name": "ruff",
          },
        },
      ],
    },
  },

  "file_scan_exclusions": [
    "**/.DS_Store",
    "**/*.pyc",
    "**/.git",
    "**/node_modules",
    "**/.venv",
    "**/__pycache__",
    ".idea",
    "**/.pytest_cache",
    "**/.ruff_cache",
  ],

  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha",
  },

  "agent": {
    "profiles": {
      "test": {
        "name": "Test",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {},
      },
    },
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
  },
  "agent_servers": {
    "Sage": {
      "favorite_models": ["claude-4-5-opus"],
      "type": "custom",
      "command": "~/.local/bin/sage",
      "args": ["acp"],
      "env": {},
    },
  },
}
