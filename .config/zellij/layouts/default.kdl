layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#8AADF4,bold]{session}"
                format_center "{tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#6E738D]{char}"
                border_position "top"

                hide_frame_for_single_pane "false"

                // Modos con líneas de pista mostrando atajos disponibles
                mode_locked        "#[bg=#A6DA95,fg=#24273A,bold] LOCKED  ^g menú "
                mode_normal        "#[bg=#8AADF4,fg=#24273A,bold] MENÚ  p panel · t tab · r resize · m mover · s scroll · o sesión · ? ayuda · g/esc "
                mode_pane          "#[bg=#C6A0F6,fg=#24273A,bold] PANE  n nuevo · x cerrar · f full · w flotante · e embed/flot · z marcos · c rename · hjkl "
                mode_tab           "#[bg=#F5A97F,fg=#24273A,bold] TAB  hl ant/sig · n nuevo · x cerrar · r rename · Tab últ · s sync · 1-9 saltar "
                mode_scroll        "#[bg=#EED49F,fg=#24273A,bold] SCROLL  jk arriba/abajo · d/u media página · e editar · / buscar "
                mode_enter_search  "#[bg=#ED8796,fg=#24273A,bold] SEARCH  Enter confirmar · Esc cancelar "
                mode_search        "#[bg=#ED8796,fg=#24273A,bold] SEARCH  n/N siguiente/anterior · jk navegar "
                mode_resize        "#[bg=#F5A97F,fg=#24273A,bold] RESIZE  hjkl aumentar · HJKL disminuir · = + - tamaño "
                mode_move          "#[bg=#F5A97F,fg=#24273A,bold] MOVE  hjkl/flechas mover panel "
                mode_session       "#[bg=#EED49F,fg=#24273A,bold] SESSION  d detach · w manager · c config · p plugins · q quit "
                mode_tmux          "#[bg=#F5A97F,fg=#24273A,bold] TMUX "
                mode_prompt        "#[bg=#6E738D,fg=#24273A,bold] PROMPT "
                mode_rename_tab    "#[bg=#F5A97F,fg=#24273A,bold] RENAME TAB  Esc cancelar · Enter confirmar "
                mode_rename_pane   "#[bg=#F5A97F,fg=#24273A,bold] RENAME PANE  Esc cancelar · Enter confirmar "

                tab_normal              "#[fg=#6E738D] {name} "
                tab_normal_fullscreen   "#[fg=#6E738D] {name} [] "
                tab_normal_sync         "#[fg=#6E738D] {name} <> "
                tab_active              "#[fg=#CAD3F5,bold,italic] {name} "
                tab_active_fullscreen   "#[fg=#CAD3F5,bold,italic] {name} [] "
                tab_active_sync         "#[fg=#CAD3F5,bold,italic] {name} <> "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#C6A0F6]  {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime        "#[fg=#6E738D,bold] {format} "
                datetime_format "%H:%M"
                datetime_timezone "Europe/Madrid"
            }
        }
    }
}
