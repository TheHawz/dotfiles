#!/bin/bash

# SQLBucket Batch Runner - Mimics manage.py syntax
# This script runs any SQLBucket project in batches to handle large data volumes
# Usage: ./batch-job [OPTIONS]

set -e  # Exit on any error

# Default values
PROJECT=""
CONNECTION=""
GROUP="main"
ENVIRONMENT="prd"
FROM_DAYS=30
FROM_DATE=""
TO_DAYS_OPT=""
TO_DATE=""
BATCH_SIZE=5
VERBOSE=false
QUIET=false
LOGGED=false
RENDER_ONLY=false
AUTO_YES=false
HELP=false

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Function to show help
show_help() {
    echo "SQLBucket Batch Runner - Mimics manage.py syntax"
    echo ""
    echo "USAGE:"
    echo "  ./batch-job -n <project> -c <connection> [OPTIONS]"
    echo ""
    echo "REQUIRED OPTIONS:"
    echo "  -n, --name <project>      Project name (e.g., reporting/twdsp_summary_metrics)"
    echo "  -c, --connection <conn>   Connection name (e.g., twdsp, dc, wl, mc)"
    echo ""
    echo "OPTIONAL OPTIONS:"
    echo "  -g, --group <group>       Group name from config.yaml (default: main)"
    echo "  -e, --env <environment>   Environment (default: prd)"
    echo "      --from-days <days>    Number of days back to start from (default: 30)"
    echo "      --to-days <days>      Number of days back to end at (default: 0)"
    echo "      --from-date <DATE>    Start date in YYYY-MM-DD format (alternative to --from-days)"
    echo "      --to-date <DATE>      End date in YYYY-MM-DD format (alternative to --to-days)"
    echo "      --batch-size <size>   Days per batch (default: 5)"
    echo ""
    echo "OUTPUT OPTIONS:"
    echo "  -v, --verbose             Show SQLBucket output (default mode)"
    echo "  -q, --quiet               Minimal output, clean progress"
    echo "      --logged              Clean output + detailed log file"
    echo ""
    echo "TESTING OPTIONS:"
    echo "  -r, --render              Render templates only, don't execute (safe mode)"
    echo ""
    echo "OTHER OPTIONS:"
    echo "  -y, --yes                Skip confirmation prompt"
    echo "  -h, --help               Show this help message"
    echo ""
    echo "EXAMPLES:"
    echo "  # Basic usage"
    echo "  ./batch-job -n reporting/twdsp_summary_metrics -c twdsp"
    echo ""
    echo "  # With custom group and environment"
    echo "  ./batch-job -n cross_game/mdi -c twdsp -g user_level_data -e dev"
    echo ""
    echo "  # Process more days in larger batches"
    echo "  ./batch-job -n dc/dragon_atlas -c dc --from-days 60 --batch-size 10"
    echo ""
    echo "  # Process a specific range of days"
    echo "  ./batch-job -n dc/dragon_atlas -c dc --from-days 90 --to-days 30"
    echo ""
    echo "  # Process from a specific date"
    echo "  ./batch-job -n dc/dragon_atlas -c dc --from-date 2025-04-01"
    echo ""
    echo "  # Process a date range"
    echo "  ./batch-job -n dc/dragon_atlas -c dc --from-date 2025-01-01 --to-date 2025-03-01"
    echo ""
    echo "  # Quiet mode for clean output"
    echo "  ./batch-job -n reporting/twdsp_summary_metrics -c twdsp -q"
    echo ""
    echo "  # Test mode (render only, safe)"
    echo "  ./batch-job -n reporting/twdsp_summary_metrics -c twdsp -r"
    echo ""
    echo "  # Logged mode for production"
    echo "  ./batch-job -n reporting/twdsp_summary_metrics -c twdsp --logged"
    echo ""
    echo "EQUIVALENT MANUAL COMMANDS:"
    echo "  # Single batch (most recent 5 days)"
    echo "  make run 'run-job -n reporting/twdsp_summary_metrics -c twdsp -g main -fd 5 -td 0 -e prd'"
    echo ""
    echo "  # Create tables (run once before first batch)"
    echo "  python manage.py run-job -n reporting/twdsp_summary_metrics -c twdsp -g create_tables -e prd"
    echo ""
    echo "  # Run integrity checks"
    echo "  python manage.py run-integrity -n reporting/twdsp_summary_metrics -c twdsp -e prd"
}

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -n|--name)
            PROJECT="$2"
            shift 2
            ;;
        -c|--connection)
            CONNECTION="$2"
            shift 2
            ;;
        -g|--group)
            GROUP="$2"
            shift 2
            ;;
        -e|--env)
            ENVIRONMENT="$2"
            shift 2
            ;;
        --days|--from-days)
            FROM_DAYS="$2"
            shift 2
            ;;
        --date|--from-date)
            FROM_DATE="$2"
            shift 2
            ;;
        --to-days)
            TO_DAYS_OPT="$2"
            shift 2
            ;;
        --to-date)
            TO_DATE="$2"
            shift 2
            ;;
        --batch-size)
            BATCH_SIZE="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --logged)
            LOGGED=true
            shift
            ;;
        -r|--render)
            RENDER_ONLY=true
            shift
            ;;
        -y|--yes)
            AUTO_YES=true
            shift
            ;;
        -h|--help)
            HELP=true
            shift
            ;;
        *)
            echo "Unknown option: $1"
            echo "Use -h or --help for usage information"
            exit 1
            ;;
    esac
done

# Show help if requested
if [ "$HELP" = true ]; then
    show_help
    exit 0
fi

# Check required arguments
if [ -z "$PROJECT" ] || [ -z "$CONNECTION" ]; then
    echo -e "${RED}Error: Missing required arguments${NC}"
    echo ""
    echo "Required:"
    echo "  -n, --name <project>      Project name"
    echo "  -c, --connection <conn>   Connection name"
    echo ""
    echo "Use -h or --help for full usage information"
    exit 1
fi

# Helper: convert a YYYY-MM-DD date to days-ago
date_to_days() {
    local label=$1
    local date_val=$2
    if ! [[ "$date_val" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        echo -e "${RED}Error: $label must be in YYYY-MM-DD format${NC}"
        exit 1
    fi
    if [[ "$(uname)" == "Darwin" ]]; then
        local epoch=$(date -j -f "%Y-%m-%d" "$date_val" "+%s" 2>/dev/null)
    else
        local epoch=$(date -d "$date_val" "+%s" 2>/dev/null)
    fi
    if [ -z "$epoch" ]; then
        echo -e "${RED}Error: Invalid date '${date_val}'${NC}"
        exit 1
    fi
    local today_epoch=$(date "+%s")
    echo $(( (today_epoch - epoch) / 86400 ))
}

# If --from-date is provided, compute FROM_DAYS from it
if [ -n "$FROM_DATE" ]; then
    FROM_DAYS=$(date_to_days "--from-date" "$FROM_DATE")
    if [ "$FROM_DAYS" -le 0 ]; then
        echo -e "${RED}Error: --from-date must be in the past${NC}"
        exit 1
    fi
fi

# If --to-date is provided, compute TO_DAYS_OPT from it
if [ -n "$TO_DATE" ]; then
    TO_DAYS_OPT=$(date_to_days "--to-date" "$TO_DATE")
    if [ "$TO_DAYS_OPT" -lt 0 ]; then
        echo -e "${RED}Error: --to-date must not be in the future${NC}"
        exit 1
    fi
fi

# Set END_DAYS (default 0 = today)
if [ -n "$TO_DAYS_OPT" ]; then
    END_DAYS=$TO_DAYS_OPT
else
    END_DAYS=0
fi

# Validate numeric arguments
if ! [[ "$FROM_DAYS" =~ ^[0-9]+$ ]] || [ "$FROM_DAYS" -le 0 ]; then
    echo -e "${RED}Error: --from-days must be a positive integer${NC}"
    exit 1
fi

if ! [[ "$END_DAYS" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Error: --to-days must be a non-negative integer${NC}"
    exit 1
fi

if [ "$END_DAYS" -ge "$FROM_DAYS" ]; then
    echo -e "${RED}Error: --to-days ($END_DAYS) must be less than --from-days ($FROM_DAYS)${NC}"
    exit 1
fi

if ! [[ "$BATCH_SIZE" =~ ^[0-9]+$ ]] || [ "$BATCH_SIZE" -le 0 ]; then
    echo -e "${RED}Error: --batch-size must be a positive integer${NC}"
    exit 1
fi

# Set output mode (quiet overrides verbose, logged overrides both)
if [ "$LOGGED" = true ]; then
    OUTPUT_MODE="logged"
elif [ "$QUIET" = true ]; then
    OUTPUT_MODE="quiet"
else
    OUTPUT_MODE="verbose"
fi

# Create log file name if in logged mode
if [ "$OUTPUT_MODE" = "logged" ]; then
    TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
    LOG_FILE="batch_${PROJECT//\//_}_${GROUP}_${CONNECTION}_${TIMESTAMP}.log"
    LOG_FILE="${LOG_FILE// /_}"  # Replace spaces with underscores
fi

# Total days to process
DAYS=$(( FROM_DAYS - END_DAYS ))

# Print configuration
echo -e "${BLUE}SQLBucket Batch Runner${NC}"
echo "======================"
echo -e "${CYAN}Project:${NC}     $PROJECT"
echo -e "${CYAN}Connection:${NC}  $CONNECTION"
echo -e "${CYAN}Group:${NC}       $GROUP"
echo -e "${CYAN}Environment:${NC} $ENVIRONMENT"
if [ -n "$FROM_DATE" ]; then
    echo -e "${CYAN}From:${NC}        $FROM_DATE ($FROM_DAYS days back)"
else
    echo -e "${CYAN}From:${NC}        $FROM_DAYS days back"
fi
if [ -n "$TO_DATE" ]; then
    echo -e "${CYAN}To:${NC}          $TO_DATE ($END_DAYS days back)"
else
    echo -e "${CYAN}To:${NC}          $END_DAYS days back"
fi
echo -e "${CYAN}Batch size:${NC}  $BATCH_SIZE days"
echo -e "${CYAN}Output mode:${NC} $OUTPUT_MODE"
if [ "$RENDER_ONLY" = true ]; then
    echo -e "${YELLOW}Mode:${NC}        RENDER ONLY (safe mode - no execution)"
fi
if [ "$OUTPUT_MODE" = "logged" ]; then
    echo -e "${CYAN}Log file:${NC}    $LOG_FILE"
fi
echo ""

# Calculate total batches
TOTAL_BATCHES=$(( (DAYS + BATCH_SIZE - 1) / BATCH_SIZE ))

# Build the command for a given from/to pair
build_cmd() {
    local fd=$1
    local td=$2
    if [ "$RENDER_ONLY" = true ]; then
        echo "make run 'run-job -n ${PROJECT} -c ${CONNECTION} -g ${GROUP} -fd ${fd} -td ${td} -e ${ENVIRONMENT} -r'"
    else
        echo "make run 'run-job -n ${PROJECT} -c ${CONNECTION} -g ${GROUP} -fd ${fd} -td ${td} -e ${ENVIRONMENT}'"
    fi
}

# Print execution plan
echo -e "${BLUE}Execution plan:${NC}"
echo ""
PLAN_FROM=$FROM_DAYS
PLAN_BATCH=1
while [ $PLAN_FROM -gt $END_DAYS ]; do
    PLAN_TO=$(( PLAN_FROM - BATCH_SIZE ))
    if [ $PLAN_TO -lt $END_DAYS ]; then
        PLAN_TO=$END_DAYS
    fi
    CMD=$(build_cmd $PLAN_FROM $PLAN_TO)
    echo -e "  ${CYAN}Batch ${PLAN_BATCH}/${TOTAL_BATCHES}${NC} (days ${PLAN_FROM} → ${PLAN_TO}):  ${YELLOW}${CMD}${NC}"
    PLAN_FROM=$PLAN_TO
    PLAN_BATCH=$(( PLAN_BATCH + 1 ))
done
echo ""

# Ask for confirmation
if [ "$AUTO_YES" != true ]; then
    echo -ne "${BLUE}Proceed with ${TOTAL_BATCHES} batches? [y/N]:${NC} "
    read -r CONFIRM
    if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Aborted.${NC}"
        exit 0
    fi
    echo ""
fi

# Function to run a single batch
run_batch() {
    local from_days=$1
    local to_days=$2
    local batch_num=$3
    local total_batches=$4
    
    local cmd
    cmd=$(build_cmd $from_days $to_days)
    
    # Output based on mode
    case $OUTPUT_MODE in
        quiet)
            printf "Batch %d/%d (days %d-%d): " $batch_num $total_batches $from_days $to_days
            if eval "$cmd" >/dev/null 2>&1; then
                echo -e "${GREEN}✅ OK${NC}"
            else
                echo -e "${RED}❌ FAILED${NC}"
                echo -e "${RED}Error:${NC} ETL job failed for days ${from_days} to ${to_days}"
                echo -e "${YELLOW}Debug command:${NC}"
                echo -e "  $cmd"
                exit 1
            fi
            ;;
        logged)
            printf "Batch %d/%d (days %d-%d): " $batch_num $total_batches $from_days $to_days
            if eval "$cmd" >>"$LOG_FILE" 2>&1; then
                echo -e "${GREEN}✅ OK${NC}"
            else
                echo -e "${RED}❌ FAILED${NC}"
                echo -e "${RED}Error:${NC} ETL job failed for days ${from_days} to ${to_days}"
                echo -e "${YELLOW}Check log:${NC} $LOG_FILE"
                echo -e "${YELLOW}Debug command:${NC}"
                echo -e "  $cmd"
                exit 1
            fi
            ;;
        verbose|*)
            echo -e "${CYAN}Running batch $batch_num/$total_batches (days $from_days-$to_days):${NC}"
            echo -e "${YELLOW}Command:${NC} $cmd"
            echo ""
            if ! eval "$cmd"; then
                echo ""
                echo -e "${RED}❌ ETL job failed for days ${from_days} to ${to_days}${NC}"
                exit 1
            fi
            echo ""
            echo -e "${GREEN}✅ Batch $batch_num/$total_batches completed successfully${NC}"
            echo ""
            ;;
    esac
}

# Initialize log file if in logged mode
if [ "$OUTPUT_MODE" = "logged" ]; then
    echo "SQLBucket Batch Runner Log" > "$LOG_FILE"
    echo "=========================" >> "$LOG_FILE"
    echo "Project: $PROJECT" >> "$LOG_FILE"
    echo "Connection: $CONNECTION" >> "$LOG_FILE"
    echo "Group: $GROUP" >> "$LOG_FILE"
    echo "Environment: $ENVIRONMENT" >> "$LOG_FILE"
    echo "From days: $FROM_DAYS" >> "$LOG_FILE"
    echo "To days: $END_DAYS" >> "$LOG_FILE"
    echo "Batch size: $BATCH_SIZE" >> "$LOG_FILE"
    echo "Started: $(date)" >> "$LOG_FILE"
    echo "" >> "$LOG_FILE"
fi

# Run batches
echo -e "${BLUE}Processing $DAYS days (from $FROM_DAYS to $END_DAYS) in $TOTAL_BATCHES batches...${NC}"
echo ""

BATCH_NUM=1
CURRENT_FROM=$FROM_DAYS

while [ $CURRENT_FROM -gt $END_DAYS ]; do
    # Calculate CURRENT_TO for this batch
    CURRENT_TO=$(( CURRENT_FROM - BATCH_SIZE ))
    
    # Ensure CURRENT_TO doesn't go below END_DAYS
    if [ $CURRENT_TO -lt $END_DAYS ]; then
        CURRENT_TO=$END_DAYS
    fi
    
    # Run the batch
    run_batch $CURRENT_FROM $CURRENT_TO $BATCH_NUM $TOTAL_BATCHES
    
    # Move to next batch
    CURRENT_FROM=$CURRENT_TO
    BATCH_NUM=$(( BATCH_NUM + 1 ))
done

# Run integrity checks
echo ""
case $OUTPUT_MODE in
    quiet)
        printf "Running integrity checks: "
        if make run 'run-integrity -n ${PROJECT} -c ${CONNECTION} -e ${ENVIRONMENT}' >/dev/null 2>&1; then
            echo -e "${GREEN}✅ PASSED${NC}"
        else
            echo -e "${YELLOW}⚠️  SKIPPED${NC} (not available or failed)"
        fi
        ;;
    logged)
        printf "Running integrity checks: "
        echo "" >> "$LOG_FILE"
        echo "=== INTEGRITY CHECKS ===" >> "$LOG_FILE"
        if make run 'manage.py run-integrity -n ${PROJECT} -c ${CONNECTION} -e ${ENVIRONMENT}' >>"$LOG_FILE" 2>&1; then
            echo -e "${GREEN}✅ PASSED${NC}"
        else
            echo -e "${YELLOW}⚠️  SKIPPED${NC} (not available or failed)"
        fi
        ;;
    verbose|*)
        echo -e "${CYAN}Running integrity checks...${NC}"
        if make run 'run-integrity -n ${PROJECT} -c ${CONNECTION} -e ${ENVIRONMENT}'; then
            echo -e "${GREEN}✅ Integrity checks passed${NC}"
        else
            echo -e "${YELLOW}⚠️  Integrity checks skipped (not available or failed)${NC}"
        fi
        ;;
esac

# Final summary
echo ""
if [ "$RENDER_ONLY" = true ]; then
    echo -e "${GREEN}🎉 Template rendering completed!${NC} All $DAYS days (from $FROM_DAYS to $END_DAYS) rendered successfully."
    echo -e "${YELLOW}Note:${NC} This was render-only mode. No data was actually processed."
else
    echo -e "${GREEN}🎉 All done!${NC} Processed $DAYS days (from $FROM_DAYS to $END_DAYS) successfully in $TOTAL_BATCHES batches."
fi

if [ "$OUTPUT_MODE" = "logged" ]; then
    echo -e "${CYAN}📋 Detailed log saved to:${NC} $LOG_FILE"
    echo "" >> "$LOG_FILE"
    echo "Completed: $(date)" >> "$LOG_FILE"
fi
